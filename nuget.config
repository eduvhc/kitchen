<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="messaging-kit" value="https://nuget.pkg.github.com/eduvhc/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <!-- Both patterns: "MessagingKit.*" does not match the bare "MessagingKit" metapackage. -->
    <packageSource key="messaging-kit">
      <package pattern="MessagingKit" />
      <package pattern="MessagingKit.*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <messaging-kit>
      <add key="Username" value="%GITHUB_PACKAGES_USER%" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </messaging-kit>
  </packageSourceCredentials>
</configuration>
