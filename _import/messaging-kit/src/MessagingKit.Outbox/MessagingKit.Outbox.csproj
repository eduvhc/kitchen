<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Transactional outbox on EF Core and PostgreSQL: enlist messages in your own transaction, deliver them with a background dispatcher.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets="none" so the analyzer shipped in Abstractions reaches consumers of this package. -->
    <ProjectReference Include="../MessagingKit.Abstractions/MessagingKit.Abstractions.csproj" PrivateAssets="none" />
  </ItemGroup>

</Project>
