<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Transactional inbox on EF Core and PostgreSQL: durable deduplication and once-only handling of received messages.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MessagingKit.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <!-- One copy of the attribute names for both halves; the inbox does not reference the outbox. -->
    <Compile Include="../MessagingKit.Outbox/Diagnostics/MessagingTags.cs" Link="Diagnostics/MessagingTags.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets="none" so the analyzer shipped in Abstractions reaches consumers of this package. -->
    <ProjectReference Include="../MessagingKit.Abstractions/MessagingKit.Abstractions.csproj" PrivateAssets="none" />
  </ItemGroup>

</Project>
