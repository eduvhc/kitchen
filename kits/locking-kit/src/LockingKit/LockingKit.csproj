  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LockingKit.Azure" />
    <InternalsVisibleTo Include="LockingKit.Postgres" />
    <InternalsVisibleTo Include="LockingKit.UnitTests" />
    <InternalsVisibleTo Include="LockingKit.Azure.UnitTests" />
    <InternalsVisibleTo Include="LockingKit.Postgres.UnitTests" />
    <InternalsVisibleTo Include="LockingKit.IntegrationTests" />
  </ItemGroup>

</Project>
