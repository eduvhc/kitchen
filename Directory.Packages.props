<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.5" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="MSTest" Version="4.5.1" />
    <PackageVersion Include="MailKit" Version="4.18.1" />
    <PackageVersion Include="MediatR" Version="14.2.0" />
    <PackageVersion Include="Mediator.Abstractions" Version="3.0.2" />
    <PackageVersion Include="Mediator.SourceGenerator" Version="3.0.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics" Version="10.0.13" />
    <!-- 10.8.0 is built on the 10.0.10 runtime packages pinned here; 10.9.0 would drag them to 10.0.11. -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <PackageVersion Include="Scriban" Version="7.5.1" />
    <!-- Transitive via MimeKit and Microsoft.Data.SqlClient; 10.0.13 patches CVE-2026-70162 and CVE-2026-84008. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Azurite" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Minio" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.16.0" />
  </ItemGroup>

</Project>
