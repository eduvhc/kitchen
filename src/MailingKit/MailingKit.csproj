<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>Email as a module: handles MessagingKit's send-email message, renders templates, and records what was sent.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MessagingKit" Version="0.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageReference Include="Scriban" Version="7.2.6" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MailingKit.UnitTests" />
  </ItemGroup>

</Project>
