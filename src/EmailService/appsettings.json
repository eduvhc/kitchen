{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5433;Database=emailservice;Username=postgres;Password=postgres"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1026,
    "Security": "None",
    "TimeoutSeconds": 30,
    "AcceptAllCertificates": false
  },
  "EmailDefaults": {
    "FromAddress": "no-reply@example.com",
    "FromName": "Example",
    "MaxAttempts": 5,
    "MaxRecipients": 50,
    "MaxAttachmentBytes": 10485760,
    "AllowedRecipientDomains": []
  },
  "Dispatcher": {
    "Enabled": true,
    "BatchSize": 20,
    "Concurrency": 4,
    "PollIntervalSeconds": 5,
    "LockDurationSeconds": 120,
    "BaseRetryDelaySeconds": 30,
    "MaxRetryDelaySeconds": 3600
  }
}
